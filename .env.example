# ==============================================================================
# Oxygen Medical RAG — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local backend development.
# In Production, configure these variables in your hosting provider dashboards:
#   - Frontend variables (VITE_*) -> Vercel Project Settings > Environment Variables
#   - Backend variables (all others) -> Render / Koyeb / Cloud Run / Hugging Face Spaces
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ------------------------------------------------------------------------------
# Build-time variable for Vite.
# REQUIRED in Production. Point to the publicly accessible URL of your FastAPI backend.
# Do NOT put trailing slash.
# Example: https://oxygen-rag-api.onrender.com
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND CORS CONFIGURATION (FastAPI Service)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed Frontend origins.
# REQUIRED in Production to allow secure cross-origin requests from Vercel to FastAPI.
# Example: https://oxygen-rag.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173,https://your-app-name.vercel.app,*

# ------------------------------------------------------------------------------
# 3. CLOUD EMBEDDING CONFIGURATION (FastAPI Service)
# ------------------------------------------------------------------------------
# Active Embedding Provider: "gemini" (recommended default), "nvidia", "mock", or "onnx" (rollback)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-2
# EMBEDDING_API_KEY is read automatically from GEMINI_API_KEY or NVIDIA_API_KEY if omitted
EMBEDDING_API_KEY=

# ------------------------------------------------------------------------------
# 4. LLM INFERENCE PROVIDERS (FastAPI Service)
# ------------------------------------------------------------------------------
# Active LLM Provider: "gemini" (recommended), "groq", "nvidia", "openai_compatible", or "mock"
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Default Provider)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Configuration (Alternative Fast Provider)
# Get key from: https://console.groq.com/
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM Configuration (Alternative High-Capacity Provider)
# Get key from: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 5. API AUTHENTICATION & SECURITY (Optional)
# ------------------------------------------------------------------------------
# Set to "true" to enforce X-API-Key header verification on /api/v1/chat
AUTH_ENABLED=false
OXYGEN_API_KEY=
